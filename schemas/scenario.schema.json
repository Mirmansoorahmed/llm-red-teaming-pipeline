{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Mirmansoorahmed/llm-red-teaming-pipeline/schemas/scenario.schema.json",
  "title": "LRTP scenario",
  "description": "A single red-team scenario in the LRTP DSL. Fields follow docs/DESIGN.md section 5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "suite",
    "language",
    "goal",
    "target",
    "profiles",
    "expected",
    "success_criteria",
    "mappings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^RT-[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "suite": {
      "type": "string",
      "enum": [
        "prompt_injection_direct",
        "prompt_injection_indirect",
        "jailbreak",
        "exfil_via_tools",
        "excessive_agency",
        "hidden_context_leak",
        "approval_binding",
        "benign"
      ]
    },
    "language": { "type": "string", "enum": ["de", "en"] },
    "goal": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "target": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["demo", "aca"] }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["vulnerable", "defended"] }
    },
    "expected": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(vulnerable|defended)$": {
          "type": "string",
          "enum": ["success", "blocked", "routed_to_review"]
        }
      },
      "additionalProperties": false
    },
    "success_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disallowed_tool": { "type": "string" },
        "tool_args": { "type": "object" },
        "data_access_resource": { "type": "string" },
        "approval_mismatch": { "type": "boolean" },
        "hidden_instruction_canary": { "type": "string" },
        "user": { "type": "string", "enum": ["junior_rep", "head_of_sales"] }
      }
    },
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owasp_llm_2026"],
      "properties": {
        "owasp_llm_2026": { "type": "array", "items": { "type": "string" } },
        "owasp_llm_2025_crosswalk": { "type": "array", "items": { "type": "string" } },
        "owasp_agentic_2026": { "type": "array", "items": { "type": "string" } },
        "atlas_v2026_10": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
